{
  "name": "Iron Notes",
  "id": "./",
  "short_name": "Iron Notes",
  "description": "Open-source training log: sets, reps, records and progress.",
  "categories": ["health", "fitness", "sports", "lifestyle"],
  "lang": "en",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#050912",
  "theme_color": "#050912",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Add exercise", "short_name": "Add", "url": "./?add", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
